+}
+
+func TestColumnsMustBeNamedOnce(t *testing.T) {
+	dsn := seed(t, `CREATE TABLE users (a TEXT)`)
+	_, _, err := export(t, sqlsrc.ExportOptions{Driver: "sqlite", DSN: dsn, Query: "SELECT a, a FROM users"})
