+
+func TestDSNNeverAppearsInAnError(t *testing.T) {
+	const dsn = "fake://sa:s3cret-passw0rd@host/db"
+	sqlsrc.Register("fake-failing", sqlsrc.Driver{
+		Open: func(dsn string) (*stdsql.DB, error) {
+			return nil, errors.New("cannot reach " + dsn)
+		},
+	})
+	_, _, err := export(t, sqlsrc.ExportOptions{Driver: "fake-failing", DSN: dsn, Query: "SELECT 1"})
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), "s3cret-passw0rd")
+	require.True(t, strings.Contains(err.Error(), "cannot reach"), "the rest of the error is kept")
+}
diff -ruN orig/iamigrate-main/pkg/connector/sql/sqlite/sqlite.go iamigrate-main/pkg/connector/sql/sqlite/sqlite.go
--- orig/iamigrate-main/pkg/connector/sql/sqlite/sqlite.go	1970-01-01 00:00:00.000000000 +0000
+++ iamigrate-main/pkg/connector/sql/sqlite/sqlite.go	2026-10-28 08:37:14.099347071 +0000
@@ -0,0 +1,42 @@
+// Package sqlite registers the SQLite engine for the sql source, through
+// modernc.org/sqlite: pure Go, so it needs no cgo, and doubles as the
+// database the connector's tests run against.
+//
+// Import it for its side effect:
+//
+//	import _ "github.com/cerberauth/iamigrate/pkg/connector/sql/sqlite"
+package sqlite
+
+import (
+	"context"
+	stdsql "database/sql"
+
+	"github.com/cerberauth/iamigrate/pkg/connector/sql"
+	_ "modernc.org/sqlite" // registers the "sqlite" database/sql driver
+)
+
+// Name is the engine's name, as used for --driver.
+const Name = "sqlite"
+
+func init() {
+	sql.Register(Name, sql.Driver{
+		Open: func(dsn string) (*stdsql.DB, error) {
+			db, err := stdsql.Open("sqlite", dsn)
+			if err != nil {
+				return nil, err
+			}
+			// query_only is a setting of the connection, so there must be
+			// only one for it to hold on the connection the query uses.
+			db.SetMaxOpenConns(1)
+			return db, nil
+		},
+		// SQLite's driver has no read-only transaction: query_only makes
+		// the connection refuse any write instead.
+		Begin: func(ctx context.Context, db *stdsql.DB, _ func(string, ...any)) (*stdsql.Tx, error) {
+			if _, err := db.ExecContext(ctx, "PRAGMA query_only = 1"); err != nil {
+				return nil, err
+			}
+			return db.BeginTx(ctx, nil)
+		},
+	})
+}
diff -ruN orig/iamigrate-main/pkg/connector/sql/sqlserver/live_test.go iamigrate-main/pkg/connector/sql/sqlserver/live_test.go
--- orig/iamigrate-main/pkg/connector/sql/sqlserver/live_test.go	1970-01-01 00:00:00.000000000 +0000
+++ iamigrate-main/pkg/connector/sql/sqlserver/live_test.go	2026-10-28 08:38:57.118885711 +0000
@@ -0,0 +1,165 @@
+package sqlserver_test
+
+import (
+	"bytes"
+	"context"
+	stdsql "database/sql"
+	"encoding/base64"
+	"encoding/hex"
+	"io"
+	"net/url"
+	"os"
+	"testing"
+
+	"github.com/cerberauth/iamigrate/pkg/cmf"
+	sqlsrc "github.com/cerberauth/iamigrate/pkg/connector/sql"
+	_ "github.com/cerberauth/iamigrate/pkg/connector/sql/sqlserver"
+	"github.com/cerberauth/iamigrate/pkg/mapping"
+	"github.com/stretchr/testify/require"
+)
+
+// These tests run against a real SQL Server, and are skipped without one:
+//
+//	docker compose -f .docker/sqlserver/docker-compose.yml up --wait
+//	SQLSERVER_DSN='sqlserver://sa:Iamigrate-Passw0rd@127.0.0.1:1433?database=master&encrypt=true&TrustServerCertificate=true' \
+//	  go test ./pkg/connector/sql/sqlserver/... -run TestLive
+//	docker compose -f .docker/sqlserver/docker-compose.yml down -v
+//
+// The DSN must be in the URL form, and its login able to create a database.
+
+const testDB = "iamigrate_test"
+
+// liveDB creates (or empties) the test database and returns the DSN of it.
+func liveDB(t *testing.T) string {
+	t.Helper()
+	dsn := os.Getenv("SQLSERVER_DSN")
+	if dsn == "" {
+		t.Skip("SQLSERVER_DSN is not set")
+	}
+	admin, err := stdsql.Open("sqlserver", dsn)
+	require.NoError(t, err)
+	defer admin.Close()
+	_, err = admin.Exec(`IF DB_ID('` + testDB + `') IS NOT NULL BEGIN ALTER DATABASE ` + testDB + ` SET SINGLE_USER WITH ROLLBACK IMMEDIATE; DROP DATABASE ` + testDB + ` END`)
+	require.NoError(t, err)
+	_, err = admin.Exec(`CREATE DATABASE ` + testDB)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		c, err := stdsql.Open("sqlserver", dsn)
+		if err == nil {
+			_, _ = c.Exec(`ALTER DATABASE ` + testDB + ` SET SINGLE_USER WITH ROLLBACK IMMEDIATE; DROP DATABASE ` + testDB)
+			c.Close()
+		}
+	})
+
+	u, err := url.Parse(dsn)
+	require.NoError(t, err)
+	q := u.Query()
+	q.Set("database", testDB)
+	u.RawQuery = q.Encode()
+	return u.String()
+}
+
+func setSnapshot(t *testing.T, dsn string, on bool) {
+	t.Helper()
+	db, err := stdsql.Open("sqlserver", dsn)
+	require.NoError(t, err)
+	defer db.Close()
+	state := "OFF"
+	if on {
+		state = "ON"
+	}
+	_, err = db.Exec(`ALTER DATABASE ` + testDB + ` SET ALLOW_SNAPSHOT_ISOLATION ` + state)
+	require.NoError(t, err)
+}
+
+func run(t *testing.T, opts sqlsrc.ExportOptions) ([]cmf.User, error) {
+	t.Helper()
+	opts.Driver = "sqlserver"
+	var buf bytes.Buffer
+	w := cmf.NewWriter(&buf)
+	if _, err := sqlsrc.New().Export(context.Background(), w, opts); err != nil {
+		return nil, err
+	}
+	require.NoError(t, w.Close())
+	r, err := cmf.NewReader(&buf)
+	require.NoError(t, err)
+	defer r.Close()
+	var users []cmf.User
+	for {
+		u, err := r.ReadUser()
+		if err == io.EOF {
+			return users, nil
+		}
+		require.NoError(t, err)
+		users = append(users, u)
+	}
+}
+
+func TestLiveVarbinaryColumnsAreRead(t *testing.T) {
+	dsn := liveDB(t)
+	db, err := stdsql.Open("sqlserver", dsn)
+	require.NoError(t, err)
+	defer db.Close()
+	digest := bytes.Repeat([]byte{0xCD}, 32)
+	salt := []byte{1, 2, 3, 4, 5, 6, 7, 8}
+	_, err = db.Exec(`CREATE TABLE users (id uniqueidentifier, email nvarchar(100), pw varbinary(64), salt varbinary(16))`)
+	require.NoError(t, err)
+	_, err = db.Exec(`INSERT INTO users VALUES ('6F9619FF-8B86-D011-B42D-00C04FC964FF', N'jane@example.com', @p1, @p2)`, digest, salt)
+	require.NoError(t, err)
+
+	m := mapping.Mapping{Fields: []mapping.FieldMapping{
+		{Source: "id", CMF: "source_id"}, {Source: "email", CMF: "email"},
+		{Source: "pw", CMF: "password"}, {Source: "salt", CMF: "password_salt"},
+		{CMF: "password_algorithm", Default: "sha256"}, {CMF: "password_encoding", Default: "hex"},
+		{CMF: "password_salt_encoding", Default: "hex"}, {CMF: "password_salt_position", Default: "prefix"},
+	}}
+	users, err := run(t, sqlsrc.ExportOptions{DSN: dsn, Query: "SELECT id, email, pw, salt FROM users", Mapping: m})
+	require.NoError(t, err)
+	require.Len(t, users, 1)
+	require.Equal(t, "6f9619ff-8b86-d011-b42d-00c04fc964ff", users[0].SourceID, "a GUID is the string SQL Server shows, not its bytes")
+	require.Equal(t, hex.EncodeToString(digest), users[0].Password.Hash.Value)
+	require.Equal(t, base64.StdEncoding.EncodeToString(salt), users[0].Password.Salt.Value)
+}
+
+// What the export ran under is asked of the server itself: 5 is snapshot,
+// 2 is read committed.
+const isolationQuery = `SELECT 'u1' AS source_id,
+	(SELECT transaction_isolation_level FROM sys.dm_exec_sessions WHERE session_id = @@SPID) AS [app_metadata.isolation]`
+
+func TestLiveSnapshotIsolationWhenTheDatabaseAllowsIt(t *testing.T) {
+	dsn := liveDB(t)
+
+	setSnapshot(t, dsn, true)
+	users, err := run(t, sqlsrc.ExportOptions{DSN: dsn, Query: isolationQuery})
+	require.NoError(t, err)
+	require.Equal(t, "5", users[0].AppMetadata["isolation"], "snapshot")
+
+	setSnapshot(t, dsn, false)
+	users, err = run(t, sqlsrc.ExportOptions{DSN: dsn, Query: isolationQuery})
+	require.NoError(t, err, "a database without snapshot isolation still exports")
+	require.Equal(t, "2", users[0].AppMetadata["isolation"], "read committed")
+}
+
+// TLS is whatever the DSN says: a server certificate the client doesn't
+// trust is refused, and trusting it is the DSN's to say. A refused
+// connection doesn't print the DSN, password included.
+func TestLiveTLSSettingsComeFromTheDSN(t *testing.T) {
+	dsn := liveDB(t)
+	u, err := url.Parse(dsn)
+	require.NoError(t, err)
+	password, _ := u.User.Password()
+
+	q := u.Query()
+	q.Set("encrypt", "true")
+	q.Set("TrustServerCertificate", "false")
+	u.RawQuery = q.Encode()
+	_, err = run(t, sqlsrc.ExportOptions{DSN: u.String(), Query: "SELECT 'u1' AS source_id"})
+	require.Error(t, err, "the container's self-signed certificate is not trusted")
+	require.NotContains(t, err.Error(), password)
+
+	q.Set("TrustServerCertificate", "true")
+	u.RawQuery = q.Encode()
+	users, err := run(t, sqlsrc.ExportOptions{DSN: u.String(), Query: "SELECT 'u1' AS source_id"})
+	require.NoError(t, err)
+	require.Len(t, users, 1)
+}
diff -ruN orig/iamigrate-main/pkg/connector/sql/sqlserver/sqlserver.go iamigrate-main/pkg/connector/sql/sqlserver/sqlserver.go
--- orig/iamigrate-main/pkg/connector/sql/sqlserver/sqlserver.go	1970-01-01 00:00:00.000000000 +0000
+++ iamigrate-main/pkg/connector/sql/sqlserver/sqlserver.go	2026-10-28 08:37:14.103305373 +0000
@@ -0,0 +1,111 @@
+// Package sqlserver registers Microsoft SQL Server (and Azure SQL) for the
+// sql source, through github.com/microsoft/go-mssqldb.
+//
+// Import it for its side effect:
+//
+//	import _ "github.com/cerberauth/iamigrate/pkg/connector/sql/sqlserver"
+//
+// The DSN is the driver's standard one, handed over untouched, so TLS is set
+// in it (encrypt, TrustServerCertificate, certificate, hostNameInCertificate)
+// and so is the way to sign in. With no fedauth parameter that is a SQL
+// login (user id and password); with one, it is Microsoft Entra
+// authentication, e.g. fedauth=ActiveDirectoryDefault.
+package sqlserver
+
+import (
+	"context"
+	stdsql "database/sql"
+	"net/url"
+	"strings"
+
+	"github.com/cerberauth/iamigrate/pkg/connector/sql"
+	mssql "github.com/microsoft/go-mssqldb"
+	"github.com/microsoft/go-mssqldb/azuread"
+)
+
+// Name is the engine's name, as used for --driver.
+const Name = "sqlserver"
+
+func init() {
+	sql.Register(Name, sql.Driver{
+		Open: func(dsn string) (*stdsql.DB, error) {
+			// The azuread driver is the same one plus Entra token
+			// acquisition, but it pulls the Azure SDK in on each use, so
+			// it only serves a DSN that asks for it.
+			if usesEntra(dsn) {
+				return stdsql.Open(azuread.DriverName, dsn)
+			}
+			return stdsql.Open("sqlserver", dsn)
+		},
+		Begin: begin,
+		Value: value,
+	})
+}
+
+// usesEntra reports whether dsn selects Microsoft Entra authentication, by
+// a fedauth parameter, in either of the driver's DSN forms (a URL, or
+// ADO-style key=value pairs separated by semicolons).
+func usesEntra(dsn string) bool {
+	if strings.Contains(dsn, "://") {
+		u, err := url.Parse(dsn)
+		if err != nil {
+			return false
+		}
+		for k, v := range u.Query() {
+			if strings.EqualFold(k, "fedauth") && len(v) > 0 && v[0] != "" {
+				return true
+			}
+		}
+		return false
+	}
+	for _, kv := range strings.Split(dsn, ";") {
+		k, v, ok := strings.Cut(kv, "=")
+		if ok && strings.EqualFold(strings.TrimSpace(k), "fedauth") && strings.TrimSpace(v) != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// begin runs the export under snapshot isolation when the database has it
+// turned on, so the export sees the data as it was when it started, whatever
+// the application writes meanwhile, without blocking those writes. When it
+// is off, the isolation level is left as the database has it (read committed,
+// or the row-versioned flavour of it if READ_COMMITTED_SNAPSHOT is on).
+//
+// SQL Server has no read-only transaction for the driver to ask for, so the
+// query is not stopped from writing: use a login that can only read.
+func begin(ctx context.Context, db *stdsql.DB, notice func(string, ...any)) (*stdsql.Tx, error) {
+	var state int
+	// 1 is ON; 2 is turning on, when it can't be relied on yet.
+	err := db.QueryRowContext(ctx, "SELECT snapshot_isolation_state FROM sys.databases WHERE name = DB_NAME()").Scan(&state)
+	switch {
+	case err != nil:
+		// Not being allowed to look isn't a reason not to export.
+		notice("could not check snapshot isolation (%v): exporting at the database's default isolation", err)
+	case state == 1:
+		return db.BeginTx(ctx, &stdsql.TxOptions{Isolation: stdsql.LevelSnapshot})
+	default:
+		notice("snapshot isolation is off on this database: exporting at the database's default isolation")
+	}
+	return db.BeginTx(ctx, nil)
+}
+
+// value renders the SQL Server types the driver doesn't give as text.
+func value(typeName string, v any) (string, bool) {
+	b, ok := v.([]byte)
+	if !ok {
+		return "", false
+	}
+	// uniqueidentifier comes as its 16 bytes in SQL Server's own order,
+	// not as the UUID string everything else shows.
+	if typeName == "UNIQUEIDENTIFIER" && len(b) == 16 {
+		var id mssql.UniqueIdentifier
+		if err := id.Scan(b); err != nil {
+			return "", false
+		}
+		return strings.ToLower(id.String()), true
+	}
+	return "", false
+}
+
diff -ruN orig/iamigrate-main/pkg/connector/sql/sqlserver/sqlserver_test.go iamigrate-main/pkg/connector/sql/sqlserver/sqlserver_test.go
--- orig/iamigrate-main/pkg/connector/sql/sqlserver/sqlserver_test.go	1970-01-01 00:00:00.000000000 +0000
+++ iamigrate-main/pkg/connector/sql/sqlserver/sqlserver_test.go	2026-10-28 08:38:31.719575207 +0000
@@ -0,0 +1,27 @@
+package sqlserver
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestUsesEntra(t *testing.T) {
+	for dsn, want := range map[string]bool{
+		// a SQL login
+		"sqlserver://sa:pw@host:1433?database=app":                                      false,
+		"server=host;user id=sa;password=pw;database=app":                              false,
+		"sqlserver://sa:pw@host?database=app&encrypt=true&TrustServerCertificate=false": false,
+		// Microsoft Entra, in the driver's two DSN forms
+		"sqlserver://host.database.windows.net?database=app&fedauth=ActiveDirectoryDefault":  true,
+		"sqlserver://host.database.windows.net?database=app&FedAuth=ActiveDirectoryAzCli":    true,
+		"server=host.database.windows.net;database=app;fedauth=ActiveDirectoryManagedIdentity": true,
+		"Server=host;Database=app; FedAuth = ActiveDirectoryServicePrincipal;":                true,
+		// an empty value selects nothing
+		"sqlserver://host?database=app&fedauth=": false,
+		// a password that merely contains the word is not a parameter
+		"sqlserver://sa:fedauth=1@host?database=app": false,
+	} {
+		require.Equal(t, want, usesEntra(dsn), dsn)
+	}
+}
diff -ruN orig/iamigrate-main/pkg/connector/sql/values.go iamigrate-main/pkg/connector/sql/values.go
--- orig/iamigrate-main/pkg/connector/sql/values.go	1970-01-01 00:00:00.000000000 +0000
+++ iamigrate-main/pkg/connector/sql/values.go	2026-10-28 08:36:56.767572048 +0000
@@ -0,0 +1,59 @@
+package sql
+
+import (
+	"encoding/hex"
+	"fmt"
+	"strconv"
+	"time"
+)
+
+// text renders one column's value the way a flat file would carry it, so
+// the mapping, hash detection and the password columns apply unchanged.
+// NULL is the empty string, like an empty CSV cell.
+//
+// Binary columns (varbinary, BLOB, bytea...) come through as bytes. A value
+// that is plain printable ASCII is kept as it is: that is a text hash an
+// application stored as bytes (a bcrypt or PHC string). Anything else is a
+// raw digest or salt, and is written in hex, which is what the
+// password_encoding and password_salt_encoding columns (set with a mapping
+// field's default, e.g. `cmf: password_encoding, default: hex`) then name.
+func text(d Driver, typeName string, v any) string {
+	if v == nil {
+		return ""
+	}
+	if d.Value != nil {
+		if s, ok := d.Value(typeName, v); ok {
+			return s
+		}
+	}
+	switch t := v.(type) {
+	case string:
+		return t
+	case []byte:
+		return bytesText(t)
+	case bool:
+		return strconv.FormatBool(t)
+	case int64:
+		return strconv.FormatInt(t, 10)
+	case int:
+		return strconv.Itoa(t)
+	case float64:
+		return strconv.FormatFloat(t, 'f', -1, 64)
+	case time.Time:
+		return t.UTC().Format(time.RFC3339Nano)
+	default:
+		return fmt.Sprint(t)
+	}
+}
+
+func bytesText(b []byte) string {
+	if len(b) == 0 {
+		return ""
+	}
+	for _, c := range b {
+		if c < 0x20 || c > 0x7e {
+			return hex.EncodeToString(b)
+		}
+	}
+	return string(b)
+}
